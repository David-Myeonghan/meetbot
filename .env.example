# Slack (api.slack.com/apps에서 manifest로 앱 생성 후 발급)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...   # Socket Mode용 (connections:write)

# 캘린더 어댑터: fake | google
CALENDAR_ADAPTER=fake

# Google Calendar (CALENDAR_ADAPTER=google일 때)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:3355/oauth/callback

# 사용자 표의 토큰 암호화 키 (32바이트 hex, `openssl rand -hex 32`)
TOKEN_ENC_KEY=

# 확산 훅 (전사 오픈 단계 기능 — 기본 꺼짐)
ENABLE_SPREAD=false

# 근무시간 (Asia/Seoul 기준)
WORK_START_HOUR=10
WORK_END_HOUR=18
